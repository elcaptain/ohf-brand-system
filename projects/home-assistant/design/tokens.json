{
  "$schema": "brand-system/tokens",
  "project": "home-assistant",
  "source": {
    "brand": "Marketing and Product Guidelines for our commercial partners, v1.1 (August 2026)",
    "ui": "https://github.com/home-assistant/frontend/tree/dev/src/resources/theme"
  },
  "draft": true,
  "color": {
    "primary": "#009ac7",
    "brand": "#18BCF2",
    "primary-dark": "#006787",
    "primary-light": "#37c8fd",
    "primary-pale": "#b9e6fc",
    "accent": "#ff9800",
    "text": "#141414",
    "text-secondary": "#5e5e5e",
    "text-disabled": "#989898",
    "surface": "#ffffff",
    "surface-low": "#f3f3f3",
    "surface-lower": "#e6e6e6",
    "error": "#db4437",
    "warning": "#ffa600",
    "success": "#43a047",
    "info": "#039be5",
    "dark": {
      "background": "#111111",
      "card": "#1c1c1c",
      "text": "#e1e1e1",
      "text-secondary": "#9b9b9b"
    }
  },
  "type": {
    "heading": {
      "family": "Roboto",
      "fallback": [
        "Noto",
        "sans-serif"
      ],
      "weights": [
        700
      ]
    },
    "body": {
      "family": "Roboto",
      "fallback": [
        "Noto",
        "sans-serif"
      ],
      "weights": [
        300,
        400,
        500
      ]
    },
    "longform": {
      "family": "ui-sans-serif",
      "fallback": [
        "system-ui",
        "sans-serif"
      ]
    },
    "code": {
      "family": "monospace"
    },
    "scale_px": {
      "xs": 10,
      "s": 12,
      "m": 14,
      "l": 16,
      "xl": 20,
      "2xl": 24,
      "3xl": 28,
      "4xl": 32,
      "5xl": 40
    },
    "line_height": {
      "condensed": 1.2,
      "normal": 1.6,
      "expanded": 2
    }
  },
  "space": {
    "unit": 8
  },
  "brand": {
    "color": {
      "ha-blue": "#18BCF2",
      "ha-black": "#1D2126",
      "ha-grey": "#6E7191",
      "ha-white": "#F2F4F9",
      "secondary": {
        "dark-blue": "#007FA8",
        "light-blue": "#CCF2FF",
        "dark-green": "#528C77",
        "light-green": "#16F3BE",
        "yellow": "#FFD502"
      },
      "product": {
        "green": "#417063",
        "voice-preview-edition": "#DF735A",
        "connect": "#006FBB"
      }
    },
    "color_print": {
      "ha-blue": {
        "pantone": "298 C",
        "cmyk": [
          65,
          3,
          0,
          0
        ]
      },
      "ha-black": {
        "pantone": "419 C",
        "cmyk": [
          76,
          65,
          66,
          90
        ]
      },
      "ha-grey": {
        "pantone": "431 C",
        "cmyk": [
          63,
          45,
          34,
          25
        ]
      },
      "ha-white": {
        "cmyk": [
          4,
          2,
          0,
          0
        ]
      },
      "product-green": {
        "pantone": "342 U",
        "cmyk": [
          92,
          12,
          66,
          43
        ]
      },
      "product-voice-preview-edition": {
        "pantone": "7579 U",
        "cmyk": [
          0,
          68,
          93,
          0
        ]
      },
      "product-connect": {
        "pantone": "300 U",
        "cmyk": [
          100,
          54,
          0,
          3
        ]
      }
    },
    "type": {
      "heading": {
        "family": "Biotif",
        "web": "Figtree",
        "weights": [
          600
        ],
        "features": [
          "liga",
          "ss02",
          "ss03"
        ]
      },
      "body": {
        "family": "Biotif",
        "web": "Instrument Sans",
        "web_stretch": "99%"
      },
      "product_name": {
        "family": "Biotif",
        "weights": [
          400
        ]
      },
      "large_text_threshold_pt": 18
    },
    "logo": {
      "clearspace": "1/3 of logomark height"
    }
  }
}