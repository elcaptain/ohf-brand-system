  "type": {
    "heading": {
      "family": "Biotif",
      "web": "Figtree",
      "fallback": [
        "Figtree",
        "sans-serif"
      ],
      "weights": [
        800,
        500
      ],
      "case": "uppercase in the logotype; headings follow brand/style.md",
      "features": [
        "liga",
        "ss02",
        "ss03"
      ]
    },
    "body": {
      "family": "Biotif",
      "web": "Instrument Sans",
      "fallback": [
        "Instrument Sans",
        "sans-serif"
      ],
      "web_stretch": "99%"
    },
    "code": {
      "family": "monospace"
    },
    "large_text_threshold_pt": 18,
    "logotype": {
      "family": "Biotif",
      "weights": {
        "OPEN HOME": 800,
        "FOUNDATION": 500
      },
      "case": "uppercase"
    }
  },
  "space": {
    "unit": 8,
    "logo_clearspace": "1/3 of logomark width",
    "note": "unit 8 is the template default, not from the source"
  }
}