{
  "$schema": "brand-system/tokens",
  "project": "music-assistant",
  "source": "Marketing and Product Guidelines for our commercial partners, v1.1 (August 2026); palette shared with home-assistant",
  "draft": false,
  "color": {
    "primary": "#18BCF2",
    "background": "#F2F4F9",
    "text": "#6E7191",
    "heading": "#1D2126",
    "ha-blue": "#18BCF2",
    "ha-black": "#1D2126",
    "ha-grey": "#6E7191",
    "ha-white": "#F2F4F9"
  },
  "type": {
    "heading": {
      "family": "Biotif",
      "web": "Figtree",
      "weights": [
        600
      ],
      "features": [
        "liga",
        "ss02",
        "ss03"
      ]
    },
    "body": {
      "family": "Biotif",
      "web": "Instrument Sans",
      "web_stretch": "99%"
    },
    "code": {
      "family": "monospace"
    },
    "large_text_threshold_pt": 18
  },
  "space": {
    "unit": 8,
    "logo_clearspace": "1/3 of logomark height",
    "note": "unit 8 is the template default, not from the source"
  }
}